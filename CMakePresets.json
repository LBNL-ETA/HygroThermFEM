{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "description": "Base: fetches all dependencies (Eigen, KeffCavity, googletest) from their declared remotes via FetchContent. Inherited by default-debug and default-release. Use a local-* preset to consume sibling working copies instead.",
            "binaryDir": "${sourceDir}/build/default"
        },
        {
            "name": "default-debug",
            "displayName": "Default (Debug)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/default-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "default-release",
            "displayName": "Default (Release)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/default-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "local",
            "hidden": true,
            "description": "Development mode: build this project and its dependency graph from sibling working copies (../<Name>) when checked out, each falling back to its remote when absent. Sets LBNL_LOCAL_SIBLINGS, a cache flag that cascades into sub-builds so the whole tree resolves locally (KeffCavity, googletest, eigen). `default` leaves it off so everything comes from remotes. Inherited by local-debug, local-release, and personal compiler presets.",
            "inherits": "default",
            "cacheVariables": {
                "LBNL_LOCAL_SIBLINGS": { "type": "BOOL", "value": "ON" }
            }
        },
        {
            "name": "local-debug",
            "displayName": "Local (Debug)",
            "inherits": "local",
            "binaryDir": "${sourceDir}/build/local-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "local-release",
            "displayName": "Local (Release)",
            "inherits": "local",
            "binaryDir": "${sourceDir}/build/local-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default-debug",
            "displayName": "Default (Debug)",
            "configurePreset": "default-debug",
            "configuration": "Debug"
        },
        {
            "name": "default-release",
            "displayName": "Default (Release)",
            "configurePreset": "default-release",
            "configuration": "Release"
        },
        {
            "name": "local-debug",
            "displayName": "Local (Debug)",
            "configurePreset": "local-debug",
            "configuration": "Debug"
        },
        {
            "name": "local-release",
            "displayName": "Local (Release)",
            "configurePreset": "local-release",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "default-debug",
            "configurePreset": "default-debug",
            "configuration": "Debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "default-release",
            "configurePreset": "default-release",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "local-debug",
            "configurePreset": "local-debug",
            "configuration": "Debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "local-release",
            "configurePreset": "local-release",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        }
    ]
}
