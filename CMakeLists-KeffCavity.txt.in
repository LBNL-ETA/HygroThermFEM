cmake_minimum_required(VERSION 3.12)

include(ExternalProject)

ExternalProject_Add(KeffCavity
    GIT_REPOSITORY https://vidanovic@bitbucket.org/vidanovic/keffcavity.git
    GIT_TAG "Version_1.0.0"
    #GIT_TAG "master"
    
    UPDATE_COMMAND ""
    PATCH_COMMAND ""
  	
    SOURCE_DIR "${CMAKE_BINARY_DIR}/KeffCavity-src"
    BINARY_DIR "${CMAKE_BINARY_DIR}/KeffCavity-build"
  	
    CONFIGURE_COMMAND ""
    BUILD_COMMAND ""
    TEST_COMMAND ""
    INSTALL_COMMAND ""
)
