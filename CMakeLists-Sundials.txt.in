cmake_minimum_required(VERSION 3.12)

include(ExternalProject)

ExternalProject_Add(Sundials
    GIT_REPOSITORY https://github.com/LLNL/sundials
    GIT_TAG "v6.5.1"
    
    UPDATE_COMMAND ""
    PATCH_COMMAND ""
  	
    SOURCE_DIR "${CMAKE_BINARY_DIR}/sundials-src"
    BINARY_DIR "${CMAKE_BINARY_DIR}/sundials-build"
  	
    CONFIGURE_COMMAND ""
    BUILD_COMMAND ""
    TEST_COMMAND ""
    INSTALL_COMMAND ""
)
